<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "windows-app": Blame.exe, the Electron
  executable that electron-builder renames and stamps with Blame's metadata,
  and the agent engine's executables (blame-engine.exe, blame-harness.exe).
  The artifact is a ZIP of these files at their paths in the app: Blame.exe
  at its root. productVersion is major.minor.patch.0, the version
  electron-builder writes into Blame.exe. The engine executables carry no
  version resource, so only their paths restrict them.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="productVersion" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="Blame.exe" product-name="Blame" product-version="${productVersion}">
      <authenticode-sign />
    </pe-file>
    <pe-file path="resources/engine/win32-x64/blame-engine.exe">
      <authenticode-sign />
    </pe-file>
    <pe-file path="resources/engine/win32-x64/blame-harness.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
