+import {OperatorFunction,MonoTypeOperatorFunction} from '../types';import {operate} from '../util/lift';import {createOperatorSubscriber} from './OperatorSubscriber';
+export function filterMap<T,R>(project:(value:T,index:number)=>{keep:true;value:R}|{keep:false}):OperatorFunction<T,R>{return operate((source,subscriber)=>{let index=0;source.subscribe(createOperatorSubscriber(subscriber,value=>{const result=project(value,index++);if(result.keep)subscriber.next(result.value);}));});}
