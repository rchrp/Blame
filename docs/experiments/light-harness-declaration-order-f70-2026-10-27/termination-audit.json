                "path": "packages/query-core/src/__tests__/isFetchingFilters.test.tsx",
                "patch": "import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'\nimport { sleep } from '@tanstack/query-test-utils'\nimport { QueryClient } from '..'\n\ndescribe('QueryClient.isFetching filters', () => {\n  let queryClient: QueryClient\n\n  beforeEach(() => {\n    vi.useFakeTimers()\n    queryClient = new QueryClient()\n  })\n\n  afterEach(() => {\n    queryClient.clear()\n    vi.useRealTimers()\n  })\n\n  it('preserves the other query filters', async () => {\n    const key = ['key'] as const\n\n    void queryClient\n      .query({\n        queryKey: key,\n        queryFn: () => sleep(10).then(() => 'data'),\n      })\n      .catch(() => undefined)\n\n    expect(queryClient.isFetching({ queryKey: key, exact: true })).toBe(1)\n    expect(\n      queryClient.getQueryCache().findAll({ fetchStatus: 'fetching' }),\n    ).toHaveLength(1)\n\n    await vi.advanceTimersByTimeAsync(10)\n    expect(queryClient.isFetching({ queryKey: key })).toBe(0)\n    expect(\n      queryClient.getQueryCache().findAll({ fetchStatus: 'idle' }),\n    ).toHaveLength(1)\n  })\n})\n"
              },
              {
                "kind": "patch",
                "path": "packages/react-query/src/__tests__/useIsFetchingFilters.test.tsx",
                "patch": "import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'\nimport { sleep } from '@tanstack/query-test-utils'\nimport { QueryClient, useIsFetching, useQuery } from '..'\nimport { renderWithClient } from './utils'\n\n describe('useIsFetching filters', () => {\n  beforeEach(() => {\n    vi.useFakeTimers()\n  })\n\n  afterEach(() => {\n    vi.useRealTimers()\n  })\n\n  it('preserves the other query filters', async () => {\n    const queryClient = new QueryClient()\n    const key = ['key'] as const\n\n    function Page() {\n      const isFetching = useIsFetching({ queryKey: key, exact: true })\n      useQuery({\n        queryKey: key,\n        queryFn: () => sleep(10).then(() => 'data'),\n      })\n\n      return <div>isFetching: {isFetching}</div>\n    }\n\n    const rendered = renderWithClient(queryClient, <Page />)\n\n    expect(rendered.getByText('isFetching: 1')).toBeInTheDocument()\n    await vi.advanceTimersByTimeAsync(10)\n    expect(rendered.getByText('isFetching: 0')).toBeInTheDocument()\n  })\n})\n"
              }
            ]
          },
