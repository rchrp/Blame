+export type Headers = Readonly<Record<string,string | readonly string[] | undefined>>;
+export interface RequestContext {correlationId:string}
+export function createRequestContext(headers:Headers,fallbackId:string):RequestContext {
+ const entries=Object.entries(headers).filter(([key])=>key.toLowerCase()==='x-correlation-id');
+ if(entries.length!==1)return {correlationId:fallbackId};
+ const raw=entries[0]![1];const value=typeof raw==='string'?raw:Array.isArray(raw)&&raw.length===1?raw[0]:undefined;
+ const trimmed=typeof value==='string'?value.trim():'';
+ return {correlationId:/^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$/.test(trimmed)?trimmed:fallbackId};
+}
