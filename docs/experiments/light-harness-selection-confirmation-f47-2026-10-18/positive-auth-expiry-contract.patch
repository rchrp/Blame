diff --git a/packages/security/src/authenticate.ts b/packages/security/src/authenticate.ts
index 30674aa..75898cf 100644
--- a/packages/security/src/authenticate.ts
+++ b/packages/security/src/authenticate.ts
@@ -1,4 +1,4 @@
 import type {Token} from './types.ts';
 import {AuthError} from './errors.ts';
 import {validSubject} from './policy.ts';
-export function authenticate(token: Token) { if(!validSubject(token)) throw new AuthError('Invalid token'); return {subject:token.subject}; }
+export function authenticate(token:Token,nowMs=Date.now(),clockSkewSeconds=0){if(!Number.isFinite(nowMs)||nowMs<0||!Number.isFinite(clockSkewSeconds)||clockSkewSeconds<0)throw new RangeError('Invalid clock');if(!validSubject(token))throw new AuthError('Invalid token');if(token.expiresAt!==undefined){if(typeof token.expiresAt!=='number'||!Number.isFinite(token.expiresAt)||token.expiresAt<0)throw new AuthError('Invalid token');if(nowMs>=(token.expiresAt+clockSkewSeconds)*1000)throw new AuthError('Expired token','expired_token');}return {subject:token.subject};}
