+export function resolveOptions(options:CsvOptions={}):ResolvedCsvOptions {const result={delimiter:options.delimiter??',',newline:options.newline??'\n',includeHeader:options.includeHeader??true};if(result.delimiter.length!==1||/["\r\n]/.test(result.delimiter)||!['\n','\r\n'].includes(result.newline))throw new RangeError('Invalid CSV options');return result;}
