+export function createCsvExporter(columns:readonly string[],options:CsvOptions={}) {const captured={...options};return (rows:readonly (readonly Cell[])[],overrides?:CsvOptions):string=>{const merged={...captured};if(overrides)for(const key of ['delimiter','newline','includeHeader'] as const){const value=overrides[key];if(value!==undefined)Object.assign(merged,{[key]:value});}const resolved=resolveOptions(merged);const lines=rows.map(row=>row.map(cell=>encodeCell(cell,resolved.delimiter)).join(resolved.delimiter));if(resolved.includeHeader)lines.unshift(columns.map(c=>encodeCell(c,resolved.delimiter)).join(resolved.delimiter));return lines.join(resolved.newline);};}
