{
  "name": "blame",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:desktop": "node scripts/desktop-release.mjs build",
    "build:runtime": "node scripts/runtime-release.mjs build",
    "build:runtime:all": "node scripts/runtime-release.mjs build --all-architectures",
    "build:runtime:macos": "node scripts/runtime-release.mjs build --platform macos",
    "build:runtime:windows": "node scripts/runtime-release.mjs build --platform windows",
    "build:sandbox-runner": "node scripts/sandbox-runner-release.mjs build",
    "dev": "node scripts/dev-with-database-tunnel.mjs",
    "dev:db": "ssh -N -T -o BatchMode=yes -o ConnectTimeout=10 -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -L 127.0.0.1:13307:127.0.0.1:13307 ubuntu@server.raphael-charpentier.fr",
    "dev:vitrine": "pnpm --filter @blame/vitrine dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "release:sandbox-runner": "node scripts/sandbox-runner-release.mjs release",
    "sync:runtime-sdk": "node scripts/runtime-sdk-version.mjs",
    "update:cline-sdk": "node scripts/cline-sdk-update.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && node --test scripts/semantic-harness-payload.test.mjs scripts/runtime-tool-context.test.mjs scripts/runtime-hub-lifecycle.test.mjs scripts/runtime-sdk-payload.test.mjs",
    "test:benchmark-corpus": "node --test tools/terminal_bench/corpus/corpus.test.mjs",
    "test:semantic-harness-payload": "node --test scripts/semantic-harness-payload.test.mjs scripts/runtime-tool-context.test.mjs scripts/runtime-hub-lifecycle.test.mjs scripts/runtime-sdk-payload.test.mjs",
    "test:release": "node --test scripts/release-preflight.test.mjs scripts/macos-signing.test.mjs scripts/desktop-release.test.mjs scripts/cline-sdk-update.test.mjs",
    "verify:runtime:macos": "node scripts/macos-runtime-image.mjs verify",
    "check:line-budgets": "node scripts/check-line-budgets.mjs",
    "licenses:extract": "node scripts/extract-open-source-projects.mjs",
    "benchmark:agent": "node packages/benchmark-runner/dist/cli.js",
    "benchmark:agent:bundle": "node scripts/headless-benchmark-payload.mjs",
    "benchmark:corpus": "node tools/terminal_bench/corpus/run-corpus.mjs",
    "benchmark:corpus:report": "node tools/terminal_bench/corpus/report-corpus.mjs",
    "benchmark:corpus:rescore": "node tools/terminal_bench/corpus/rescore-corpus.mjs",
    "benchmark:preview-runtime": "node --experimental-strip-types scripts/benchmark-preview-runtime.mjs"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.14",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  }
}
