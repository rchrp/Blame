ARG UBUNTU_IMAGE=ubuntu:24.04@sha256:4fbb8e6a8395de5a7550b33509421a2bafbc0aab6c06ba2cef9ebffbc7092d90
FROM ${UBUNTU_IMAGE}

ARG BLAME_RUNTIME_VERSION
ARG BLAME_CLINE_SDK_VERSION
ARG BLAME_DOCKER_VERSION=29.9.1
ARG BLAME_COMPOSE_VERSION=5.6.0
ARG BLAME_BUILDX_VERSION=0.38.0
ARG BLAME_NODE_VERSION=22.23.1

COPY packages/desktop/resources/runtime/windows/scripts/provision-blame-runtime.sh /tmp/provision-blame-runtime.sh
COPY deploy/runtime-builder/blame-semantic-harness.tgz /tmp/blame-semantic-harness.tgz
COPY deploy/runtime-builder/wsl.conf /etc/wsl.conf

RUN BLAME_RUNTIME_BAKE=1 \
    BLAME_DOCKER_VERSION="${BLAME_DOCKER_VERSION}" \
    BLAME_COMPOSE_VERSION="${BLAME_COMPOSE_VERSION}" \
    BLAME_BUILDX_VERSION="${BLAME_BUILDX_VERSION}" \
    BLAME_NODE_VERSION="${BLAME_NODE_VERSION}" \
    sh /tmp/provision-blame-runtime.sh "${BLAME_RUNTIME_VERSION}" "${BLAME_CLINE_SDK_VERSION}" \
    && grep -qx "${BLAME_RUNTIME_VERSION}" /etc/blame-runtime-version \
    && blame-runtime-agent version | grep -qx "${BLAME_RUNTIME_VERSION}" \
    && node -e 'process.exit(process.versions.node === process.argv[1] ? 0 : 1)' "${BLAME_NODE_VERSION}" \
    && node "$(npm root -g)/@blame/semantic-harness-runtime/runtime-sdk-check.mjs" "${BLAME_CLINE_SDK_VERSION}" \
    && command -v blame-semantic-harness >/dev/null \
    && test -s /etc/blame-semantic-harness-sha256 \
    && test -z "$(find "$(npm root -g)" -type d \( -path "*/node_modules/@openai/codex-linux-*" -o -path "*/node_modules/@anthropic-ai/claude-agent-sdk-linux-*" \) -print -quit)" \
    && docker --version | grep -q "Docker version ${BLAME_DOCKER_VERSION}," \
    && dockerd --version \
    && test -x /usr/local/bin/docker-init \
    && test "$(docker compose version --short)" = "${BLAME_COMPOSE_VERSION}" \
    && docker buildx version | grep -q " v${BLAME_BUILDX_VERSION} " \
    && test -s /etc/docker/daemon.json \
    && id blame \
    && rm -f /tmp/provision-blame-runtime.sh \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* /root/.npm /root/.cache

CMD ["/bin/true"]
