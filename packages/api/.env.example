# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=replace-with-at-least-32-random-characters
APP_KEY_PREVIOUS=
ACCOUNT_CLOSURE_LEDGER_DIRECTORY=/var/lib/blame/account-closure-ledger
APP_URL=http://${HOST}:${PORT}

BETTER_AUTH_URL=http://${HOST}:${PORT}
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_TRUSTED_ORIGINS=http://${HOST}:${PORT},http://localhost:5173
BLAME_SITE_URL=https://blame.so

# Mail
AUTH_EMAIL_FROM=Blame <auth@blame.so>
RESEND_API_KEY=

# OAuth client
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Telemetry
BLAME_TELEMETRY_MAX_PAYLOAD_BYTES=4194304
BLAME_TELEMETRY_PUBLIC_ENDPOINT=http://${HOST}:${PORT}/api/v1/telemetry/otlp
BLAME_TELEMETRY_REQUESTS_PER_MINUTE=120
BLAME_TELEMETRY_TOKEN_SECRET=replace-with-at-least-32-random-characters
BLAME_TELEMETRY_TOKEN_TTL_SECONDS=900
BLAME_TELEMETRY_UPSTREAM_ENDPOINT=http://127.0.0.1:4318
BLAME_TELEMETRY_UPSTREAM_HEADERS=
BLAME_TELEMETRY_UPSTREAM_TIMEOUT_MS=10000

# Attachments
ATTACHMENTS_STORAGE_DRIVER=s3
ATTACHMENTS_MAX_BYTES=10485760
ATTACHMENTS_DOWNLOAD_URL_TTL_SECONDS=900
ATTACHMENTS_UPLOAD_URL_TTL_SECONDS=900
ATTACHMENTS_ORPHAN_GRACE_HOURS=24
ATTACHMENTS_S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
ATTACHMENTS_S3_REGION=gra
ATTACHMENTS_S3_BUCKET=blame-prod-attachments-gra
ATTACHMENTS_S3_ACCESS_KEY_ID=
ATTACHMENTS_S3_SECRET_ACCESS_KEY=
ATTACHMENTS_S3_FORCE_PATH_STYLE=false

# Managed preview workspace artifacts (dedicated private bucket, never attachments)
BLAME_WORKSPACE_STORAGE_DRIVER=s3
BLAME_WORKSPACE_DOWNLOAD_URL_TTL_SECONDS=300
BLAME_WORKSPACE_UPLOAD_URL_TTL_SECONDS=300
BLAME_WORKSPACE_S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
BLAME_WORKSPACE_S3_REGION=gra
BLAME_WORKSPACE_S3_BUCKET=blame-prod-workspace-gra
BLAME_WORKSPACE_S3_ACCESS_KEY_ID=
BLAME_WORKSPACE_S3_SECRET_ACCESS_KEY=
BLAME_WORKSPACE_S3_FORCE_PATH_STYLE=false

# Managed cloud previews
BLAME_CLOUD_RUNTIME_ENABLED=false
BLAME_PREVIEW_MAX_ACTIVE_PER_USER=2
BLAME_PREVIEW_MAX_CONCURRENT_VCPUS_PER_USER=8
BLAME_PREVIEW_MAX_CREATIONS_PER_MINUTE=3
BLAME_PREVIEW_MAX_CREATIONS_PER_DAY=20
BLAME_PREVIEW_MAX_CREATIONS_PER_MONTH=100
BLAME_PREVIEW_MONTHLY_BUDGET_USD=20
BLAME_PREVIEW_GLOBAL_MONTHLY_BUDGET_USD=1000
BLAME_PREVIEW_DISABLED_TENANT_IDS=
BLAME_PREVIEW_IDLE_TIMEOUT_MINUTES=15
BLAME_PREVIEW_SUSPENDED_RETENTION_MINUTES=60
BLAME_PREVIEW_MAX_RETAINED_SUSPENDED=4
BLAME_PREVIEW_LEASE_SECONDS=90
BLAME_PREVIEW_RPO_SECONDS=10
BLAME_PREVIEW_BASELINES_ENABLED=true
BLAME_PREVIEW_BASELINE_RETENTION_DAYS=7
BLAME_PREVIEW_BASELINE_MAX_UNREFERENCED=1
BLAME_PREVIEW_BASELINE_WAIT_SECONDS=90
BLAME_PREVIEW_BASELINE_MAX_BUILDERS=1
BLAME_PREVIEW_EDGE_ORIGIN=https://preview.blame.dev
BLAME_PREVIEW_TICKET_TTL_SECONDS=60
BLAME_PREVIEW_EDGE_CONTROL_TOKEN=replace-with-at-least-32-random-characters
BLAME_PREVIEW_CAPABILITY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nreplace-me\n-----END PUBLIC KEY-----"
BLAME_PREVIEW_CAPABILITY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----"
BLAME_SANDBOX_RUNNER_IMAGE=vcr.vercel.com/team/project/blame-runner@sha256:replace-me
BLAME_SANDBOX_BOOTSTRAP_URL=
BLAME_SANDBOX_BOOTSTRAP_SHA256=
BLAME_SANDBOX_RUNNER_VERSION=0.2.18
BLAME_SANDBOX_PROTOCOL_VERSION=3
BLAME_SANDBOX_VERCEL_PLAN=hobby
BLAME_SANDBOX_TIMEOUT_MINUTES=60
BLAME_SANDBOX_SNAPSHOT_RETENTION_DAYS=7
BLAME_SANDBOX_DEPLOYMENT_ID=development
BLAME_SANDBOX_EGRESS_ALLOWLIST=registry.npmjs.org,*.npmjs.org,github.com,codeload.github.com,*.githubusercontent.com,auth.docker.io,registry-1.docker.io,production.cloudfront.docker.com,docker-images-prod.s3.dualstack.us-east-1.amazonaws.com
VERCEL_ACCESS_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# User-owned Vercel deployments (Connectable Account Integration)
VERCEL_INTEGRATION_CLIENT_ID=
VERCEL_INTEGRATION_CLIENT_SECRET=
VERCEL_INTEGRATION_SLUG=
VERCEL_INTEGRATION_REDIRECT_URI=https://api.blame.so/api/v1/integrations/vercel/callback

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=

# Session
SESSION_DRIVER=cookie

# Stripe Billing (use test keys locally; never commit real secrets)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_MONTHLY_PRICE_ID=price_replace_monthly
STRIPE_YEARLY_PRICE_ID=price_replace_yearly
STRIPE_CHECKOUT_SUCCESS_URL=https://blame.so/billing/success
STRIPE_CHECKOUT_CANCEL_URL=https://blame.so/billing/cancelled
STRIPE_PORTAL_RETURN_URL=https://blame.so/billing/portal-return

# Model Catalog
BLAME_MODEL_CATALOG_LIVE_REFRESH=true
BLAME_MODEL_CATALOG_REFRESH_HOURS=6
BLAME_MODELS_DEV_URL=https://models.dev/api.json
OPENROUTER_API_KEY=
BLAME_SPEECH_TO_TEXT_MODEL=openai/gpt-transcribe
BLAME_SPEECH_TO_TEXT_REQUESTS_PER_MINUTE=20
BLAME_SPEECH_TO_TEXT_MAX_CONCURRENT=2
BLAME_SPEECH_TO_TEXT_TIMEOUT_MS=60000

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000
