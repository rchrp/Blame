{
  "name": "@blame/engine-client",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.0.0",
  "type": "module",
  "description": "TypeScript client of the Blame agent engine: protocol types generated from Rust, the process client, session following and the transcript reducer.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./transcript": {
      "types": "./src/transcript/index.ts",
      "default": "./dist/transcript/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "check:generated": "node scripts/generate-types.mjs --check",
    "generate": "node scripts/generate-types.mjs",
    "lint": "eslint .",
    "test": "pnpm build && node --test \"dist/**/*.test.js\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.72.1",
    "@typescript/native": "npm:typescript@7.0.2"
  }
}
