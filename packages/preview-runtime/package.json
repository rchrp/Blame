{
  "name": "@blame/preview-runtime",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "default": "./dist/testing/index.js"
    },
    "./workspace-ignore": {
      "types": "./src/workspace/workspace-ignore.ts",
      "default": "./dist/workspace/workspace-ignore.js"
    },
    "./compose": {
      "types": "./src/compose/index.ts",
      "default": "./dist/compose/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --test dist/*.test.js dist/**/*.test.js"
  },
  "dependencies": {
    "@blame/preview-contract": "workspace:*",
    "ignore": "7.0.5",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "typescript": "~5.9.3"
  }
