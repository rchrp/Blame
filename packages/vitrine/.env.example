NEXT_PUBLIC_BLAME_API_URL=https://api.blame.so/api/v1
STRIPE_CUSTOMER_PORTAL_URL=https://billing.stripe.com/p/login/replace-with-your-live-portal-link

# The demo video upload has its own settings: see .env.media.example.

# The publisher's details for the legal notice and the legal documents
# (lib/publisher.ts). Pages are prerendered, so they are read at build time:
# set them in .env.local (gitignored) for development, and as Docker build
# arguments in production. A production build fails without them; the values
# below are enough for a local build.
VITRINE_PUBLISHER_ADDRESS="1 rue Exemple, 75000 Paris, France"
VITRINE_PUBLISHER_PHONE="+33 6 00 00 00 00"
VITRINE_PUBLISHER_SIREN="123 456 789"
