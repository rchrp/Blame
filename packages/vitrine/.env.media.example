# Settings for the demo video upload (pnpm upload:demo-media) only: the site
# never reads them, it plays the public URLs in lib/demo-media-manifest.json.
# Copy this file to .env.media, which is gitignored and which Next.js doesn't
# load, then fill in the S3 user's keys.
#
# One-time setup in the OVH console (Public Cloud > Object Storage):
# - a bucket of its own, Standard class in GRA, left private: OVH has no
#   bucket policies yet, so the script makes each video public with a
#   public-read ACL, and nobody can list the bucket;
# - an S3 user for this bucket alone: import scripts/media-bucket-user-policy.json
#   as its policy (with the bucket's name, if it isn't the one below), so its
#   keys can't reach the attachments or backups buckets.
VITRINE_MEDIA_S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
VITRINE_MEDIA_S3_REGION=gra
VITRINE_MEDIA_S3_BUCKET=blame-prod-vitrine-media-gra
VITRINE_MEDIA_S3_ACCESS_KEY_ID=
VITRINE_MEDIA_S3_SECRET_ACCESS_KEY=
VITRINE_MEDIA_S3_FORCE_PATH_STYLE=false
